rules_version = '2';

// The Firestore rules of docs/PLAN.md section 3.1. Anything no rule below allows is denied.
// M1-08, the base: signedIn(), the users doc, config/app, the caller's own member path and the
// tombstone read. M1-10: Create household + owner and the own display name. M1-53: Transfer
// ownership (the household update and the role update of a member doc). Every later allow
// statement starts `if signedIn() && ...` (rules.test.ts checks it), and its allow tests go through
// verifiedOnly (firebase/test/harness.ts), which fails unless an unverified token is denied.
// Layout (docs/adr/0002-rules-spike.md): one allow statement per method of a match; in its function
// the conditions that make no get()/exists() call come first, so the ADR's call counts hold.
service cloud.firestore {
  match /databases/{database}/documents {
    // PLAN 3.1 "Signed in": a verified email. The own users doc and config/app are the two exceptions.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The caller is `uid`, verified email or not (the own users doc: AUTH-06, HH-03).
    function isCaller(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function householdDoc(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberDoc(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // A name (PLAN 3.1 field validation, P4): 1-50 code points, non-empty after trim. The regex counts
    // them (`.` is one code point; (?s) lets it match a line break too). Not size(): on the emulator it
    // counts UTF-16 units, 100 for 50 non-BMP characters (option A, #15 comment 7083518706).
    function validName(name) {
      return name is string && name.matches('(?s).{1,50}') && name.trim().size() > 0;
    }

    // The users doc (PLAN 3.1, P9): householdId, always present, and name, optional.
    function validUser(data) {
      return data.keys().hasAll(['householdId'])
        && data.keys().hasOnly(['householdId', 'name'])
        && (!('name' in data) || validName(data.name));
    }

    // householdId (PLAN 3.1, P5): unchanged; set (null -> hid) only with the caller's member doc in a
    // live household after the write, as in the create-household and join batches; cleared
    // (hid -> null) only once the caller's member doc is gone after the write. Never hid1 -> hid2.
    function householdIdChange(before, after) {
      return after == before
        || (before == null && after is string
          && existsAfter(memberDoc(after, request.auth.uid))
          && getAfter(householdDoc(after)).data.deleted == false)
        || (before != null && after == null
          && !existsAfter(memberDoc(before, request.auth.uid)));
    }

    // Get the household doc (PLAN 3.1 Reads): a member of the live household, M(uid) and LIVE
    // (M1-83); or the tombstone read (M1-08), the household deleted and the caller's householdId
    // pointing at it (the HH-06 dialog, the self-heal, the owner's cleanup resume). Each path tests
    // deleted, which makes no call, first, so a get makes one call (ADR 0002).
    function readsHousehold(hid) {
      let household = resource.data;
      return (household.deleted == false && exists(memberDoc(hid, request.auth.uid)))
        || (household.deleted == true && get(userDoc(request.auth.uid)).data.householdId == hid);
    }

    // Get any member doc or list the members (PLAN 3.1 Reads, M1-83): a member of the live
    // household, M(uid) and LIVE; two calls. The owner's cleanup reads under a tombstone are M1-11's
    // path here.
    function readsMembers(hid) {
      let household = get(householdDoc(hid)).data;
      return household.deleted == false && exists(memberDoc(hid, request.auth.uid));
    }

    // Create household + owner, one batch (PLAN 3.1): the caller creates and owns a household whose
    // id is a Firestore auto-id (P3), with the caller's member doc after the batch. Household docs are
    // never deleted (#199), so an id that has existed stays taken. On create !exists always holds; it
    // stays as the row has it.
    function createsHousehold(hid) {
      let data = request.resource.data;
      return hid.matches('^[A-Za-z0-9]{20}$')
        && data.keys().hasAll(['name', 'createdBy', 'createdAt', 'ownerUid', 'deleted'])
        && data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'ownerUid', 'deleted'])
        && validName(data.name) && data.createdBy == request.auth.uid
        && data.ownerUid == request.auth.uid && data.createdAt == request.time
        && data.deleted == false
        && !exists(householdDoc(hid)) && existsAfter(memberDoc(hid, request.auth.uid));
    }

    // A member create (PLAN 3.1): the caller's own member doc (P1). Here the owner's, in Create
    // household: role owner, in a household that does not exist before the batch and names the
    // caller as owner after it, with the one-household check. The joiner's is M1-54's path.
    function createsMember(hid, uid) {
      let doc = request.resource.data;
      return uid == request.auth.uid && doc.role == 'owner'
        && doc.keys().hasAll(['role', 'displayName', 'joinedAt'])
        && doc.keys().hasOnly(['role', 'displayName', 'joinedAt'])
        && validName(doc.displayName) && doc.joinedAt == request.time
        && !exists(householdDoc(hid))
        && getAfter(householdDoc(hid)).data.ownerUid == request.auth.uid
        && oneHousehold(hid);
    }

    // The one-household check of a member create (PLAN 3.1): the caller's users doc exists and holds
    // no household before the batch and this one after it, so the same batch must set it. A missing
    // doc fails; a stale value must be self-healed first.
    function oneHousehold(hid) {
      let user = userDoc(request.auth.uid);
      return exists(user) && get(user).data.householdId == null
        && getAfter(user).data.householdId == hid;
    }

    // Transfer ownership, the household update (PLAN 3.1): the owner of the live household changes
    // only ownerUid, to a member before and after the batch, after which the old owner's role is
    // member and the new owner's owner, so the batch holds both role updates (no partial transfer).
    // O(uid) is ownerUid before the batch, never M(uid). The new ownerUid is a string (P4): a path
    // takes a number as a document id. The soft delete is M1-11's path here.
    function updatesHousehold(hid) {
      let before = resource.data;
      let after = request.resource.data;
      return before.deleted == false && before.ownerUid == request.auth.uid
        && after.ownerUid is string && after.diff(before).affectedKeys().hasOnly(['ownerUid'])
        && exists(memberDoc(hid, after.ownerUid)) && existsAfter(memberDoc(hid, after.ownerUid))
        && getAfter(memberDoc(hid, before.ownerUid)).data.role == 'member'
        && getAfter(memberDoc(hid, after.ownerUid)).data.role == 'owner';
    }

    // A member doc update (PLAN 3.1) while the household is live; an update implies the doc. Two
    // paths: the caller's own displayName, a name (P4); and the transfer's role update, by the owner
    // before the batch (O(uid)), to the role ownerUid gives this doc after it: owner for the new
    // owner, member for anyone else. ownerUid is the source of truth, role a cached copy.
    function updatesMember(hid, uid) {
      let household = get(householdDoc(hid)).data;
      let doc = request.resource.data;
      let changed = doc.diff(resource.data).affectedKeys();
      return household.deleted == false
        && ((uid == request.auth.uid && changed.hasOnly(['displayName'])
            && validName(doc.displayName))
          || (household.ownerUid == request.auth.uid && changed.hasOnly(['role'])
            && doc.role == (getAfter(householdDoc(hid)).data.ownerUid == uid ? 'owner' : 'member')));
    }

    match /users/{uid} {
      allow get: if isCaller(uid);
      allow create: if isCaller(uid) && validUser(request.resource.data)
        && request.resource.data.householdId == null;
      allow update: if isCaller(uid) && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'name'])
        && householdIdChange(resource.data.householdId, request.resource.data.householdId);
      // Only with householdId null, never with a value, live or stale (P5); a delete of no doc is
      // allowed, so a resumed account deletion can repeat it (P7).
      allow delete: if isCaller(uid) && (resource == null || resource.data.householdId == null);
    }

    match /households/{hid} {
      // A member's read of the live household, or the tombstone read (readsHousehold).
      allow get: if signedIn() && readsHousehold(hid);
      allow create: if signedIn() && createsHousehold(hid);
      allow update: if signedIn() && updatesHousehold(hid);

      // get: the caller's own member path in any household, live, a tombstone or none; it may not
      // exist. create and update: only as createsMember and updatesMember allow (the owner's doc
      // before the household exists; while it is live, the own displayName and the transfer's role).
      match /members/{uid} {
        // get, besides the own path, and list: a member of the live household (readsMembers).
        allow get: if signedIn() && (request.auth.uid == uid || readsMembers(hid));
        allow list: if signedIn() && readsMembers(hid);
        allow create: if signedIn() && createsMember(hid, uid);
        allow update: if signedIn() && updatesMember(hid, uid);
      }
    }

    // The app config document (PLAN 3, START-01): anyone reads it, even signed out, so an old app
    // can ask for an update before sign-in. No client writes it; the owner edits it in the console.
    match /config/app {
      allow get: if true;
    }
  }
}
