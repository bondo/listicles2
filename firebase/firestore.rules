rules_version = '2';

// The Firestore rules of docs/PLAN.md section 3.1. Anything no rule below allows is denied.
// M1-08, the base: signedIn(), the users doc, config/app, the caller's own member path and the
// tombstone read. M1-10: Create household + owner and the own display name. M1-53: Transfer
// ownership (the household update and the role update of a member doc). M1-12: the invite rows
// (create, get, list as the owner decided on #280, revoke and expired cleanup). M1-54: Join (the
// joiner's member doc and invite delete, in one batch with the users-doc set). M1-95, split from
// M1-11: the soft delete, the owner's tombstone cleanup and P6 (a member's delete of their own
// member doc under a tombstone). M1-11: Leave and Remove member (the member deletes, the removed
// marker's writes, the owner's markers in a live household). Every later allow statement starts
// `if signedIn() && ...` (rules.test.ts checks it), and its allow tests go through verifiedOnly
// (firebase/test/harness.ts), which fails unless an unverified token is denied.
// Layout (docs/adr/0002-rules-spike.md): one allow statement per method of a match; in its function
// the conditions that make no get()/exists() call come first, so the ADR's call counts hold.
service cloud.firestore {
  match /databases/{database}/documents {
    // PLAN 3.1 "Signed in": a verified email. The own users doc and config/app are the two exceptions.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The caller is `uid`, verified email or not (the own users doc: AUTH-06, HH-03).
    function isCaller(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function householdDoc(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberDoc(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function inviteDoc(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function markerDoc(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/removed/$(uid);
    }

    // A name (PLAN 3.1 field validation, P4): 1-50 code points, not blank. The first regex counts
    // them (`.` is one code point; (?s) lets it match a line break too). Not size(): on the emulator it
    // counts UTF-16 units, 100 for 50 non-BMP characters (option A, #15 comment 7083518706). Blank
    // (M1-90): every code point is U+0000 to U+0020, which trim() strips, or Unicode White_Space,
    // which trim() keeps above U+0020; the app's Validation removes the same code points from both
    // ends of a name before it writes it.
    function validName(name) {
      return name is string && name.matches('(?s).{1,50}')
        && !name.matches('[\\x{0}-\\x{20}\\x{85}\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}]*');
    }

    // The users doc (PLAN 3.1, P9): householdId, always present, and name, optional.
    function validUser(data) {
      return data.keys().hasAll(['householdId'])
        && data.keys().hasOnly(['householdId', 'name'])
        && (!('name' in data) || validName(data.name));
    }

    // householdId (PLAN 3.1, P5): unchanged; set (null -> hid) only with the caller's member doc in a
    // live household after the write, as in the create-household and join batches; cleared
    // (hid -> null) only once the caller's member doc is gone after the write. Never hid1 -> hid2.
    function householdIdChange(before, after) {
      return after == before
        || (before == null && after is string
          && existsAfter(memberDoc(after, request.auth.uid))
          && getAfter(householdDoc(after)).data.deleted == false)
        || (before != null && after == null
          && !existsAfter(memberDoc(before, request.auth.uid)));
    }

    // Get the household doc (PLAN 3.1 Reads): a member of the live household, M(uid) and LIVE
    // (M1-83); or the tombstone read (M1-08), the household deleted and the caller's householdId
    // pointing at it (the HH-06 dialog, the self-heal, the owner's cleanup resume). Each path tests
    // deleted, which makes no call, first, so a get makes one call (ADR 0002).
    function readsHousehold(hid) {
      let household = resource.data;
      return (household.deleted == false && exists(memberDoc(hid, request.auth.uid)))
        || (household.deleted == true && get(userDoc(request.auth.uid)).data.householdId == hid);
    }

    // The owner's tombstone cleanup (PLAN 3.1 Delete household), on the household doc a rule has
    // read: while it is deleted, its owner (O(uid)) gets, lists and deletes what is under it, one
    // rule per subcollection (members, removed) and the household's invites; never the household
    // doc itself (#199). Makes no call.
    function cleansUp(household) {
      return household.deleted == true && household.ownerUid == request.auth.uid;
    }

    // Get any member doc or list the members (PLAN 3.1 Reads, M1-83): a member of the live
    // household, M(uid) and LIVE, two calls; or the owner's cleanup under a tombstone, one.
    function readsMembers(hid) {
      let household = get(householdDoc(hid)).data;
      return (household.deleted == false && exists(memberDoc(hid, request.auth.uid)))
        || cleansUp(household);
    }

    // Delete a member doc (PLAN 3.1); paths in ADR 0002's order. Leave, one call: a member who is
    // not the owner (!O(uid)) deletes their own member doc, which exists (M(uid)), while the
    // household is live; the same batch deletes their invites and clears their householdId. P6,
    // one call: the caller's own under a tombstone, which the self-heal deletes before it clears
    // householdId. A delete of no doc is allowed there, so a self-heal after the cleanup, or a
    // resumed one, sends the same batch; so whoever knows a household id can tell whether it is a
    // tombstone. The owner's cleanup, one call: any. Remove member, three calls: the owner of the
    // live household deletes another member's, who is not the owner after the batch either (no
    // hand-over and removal in one batch), with the marker written in the same batch.
    function deletesMember(hid, uid) {
      let household = get(householdDoc(hid)).data;
      return (uid == request.auth.uid && resource != null && household.deleted == false
          && household.ownerUid != request.auth.uid)
        || (uid == request.auth.uid && household.deleted == true)
        || cleansUp(household)
        || (household.deleted == false && household.ownerUid == request.auth.uid
          && uid != household.ownerUid
          && uid != getAfter(householdDoc(hid)).data.ownerUid
          && getAfter(markerDoc(hid, uid)).data.removedAt == request.time);
    }

    // Get, list and delete the removed markers (PLAN 3.1): only the owner (O(uid)), of the live
    // household (M1-11) or in the tombstone cleanup; one call.
    function managesMarkers(hid) {
      let household = get(householdDoc(hid)).data;
      return (household.deleted == false && household.ownerUid == request.auth.uid)
        || cleansUp(household);
    }

    // Write a removed marker (PLAN 3.1 Remove member), a create or an overwrite of a leftover one,
    // so a member can be removed again after a rejoin: by the owner of the live household
    // (O(uid)), for a member before the batch whose member doc the batch deletes; it holds only
    // removedAt, the request time (P4: `keys` are those of a create, or those an overwrite
    // changes). Three calls.
    function writesMarker(hid, uid, keys) {
      let household = get(householdDoc(hid)).data;
      return household.deleted == false && household.ownerUid == request.auth.uid
        && keys.hasOnly(['removedAt']) && request.resource.data.removedAt == request.time
        && exists(memberDoc(hid, uid)) && !existsAfter(memberDoc(hid, uid));
    }

    // Create household + owner, one batch (PLAN 3.1): the caller creates and owns a household whose
    // id is a Firestore auto-id (P3), with the caller's member doc after the batch. Household docs are
    // never deleted (#199), so an id that has existed stays taken. On create !exists always holds; it
    // stays as the row has it.
    function createsHousehold(hid) {
      let data = request.resource.data;
      return hid.matches('^[A-Za-z0-9]{20}$')
        && data.keys().hasAll(['name', 'createdBy', 'createdAt', 'ownerUid', 'deleted'])
        && data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'ownerUid', 'deleted'])
        && validName(data.name) && data.createdBy == request.auth.uid
        && data.ownerUid == request.auth.uid && data.createdAt == request.time
        && data.deleted == false
        && !exists(householdDoc(hid)) && existsAfter(memberDoc(hid, request.auth.uid));
    }

    // A member create (PLAN 3.1): the caller's own member doc (P1), a name (P4), joined at the
    // request time, with the one-household check; the owner's in Create household or the joiner's
    // in Join, told apart by role, which makes no call (ADR 0002).
    function createsMember(hid, uid) {
      let doc = request.resource.data;
      return uid == request.auth.uid && validName(doc.displayName) && doc.joinedAt == request.time
        && ((doc.role == 'owner' && createsOwner(hid, doc))
          || (doc.role == 'member' && joins(hid, doc)))
        && oneHousehold(hid);
    }

    // The owner's member doc (Create household): its keys (P4), in a household that does not exist
    // before the batch and names the caller as owner after it.
    function createsOwner(hid, doc) {
      return doc.keys().hasAll(['role', 'displayName', 'joinedAt'])
        && doc.keys().hasOnly(['role', 'displayName', 'joinedAt'])
        && !exists(householdDoc(hid))
        && getAfter(householdDoc(hid)).data.ownerUid == request.auth.uid;
    }

    // The joiner's member doc (Join): its keys (P4) and viaInvite, a string (P4), the code of the
    // invite joinsVia checks. A create implies !M(uid) before the batch. The invite is read in an
    // argument, after the checks that make no call (ADR 0002).
    function joins(hid, doc) {
      return doc.keys().hasAll(['role', 'displayName', 'joinedAt', 'viaInvite'])
        && doc.keys().hasOnly(['role', 'displayName', 'joinedAt', 'viaInvite'])
        && doc.viaInvite is string
        && joinsVia(hid, doc.viaInvite, get(inviteDoc(doc.viaInvite)).data);
    }

    // The invite of a join (PLAN 3.1): it exists (a get() of no document fails), points at the
    // household and has not expired, its creator is still a member, and the same batch deletes it
    // (single use); the household is live.
    function joinsVia(hid, code, invite) {
      return invite.householdId == hid && invite.expiresAt > request.time
        && exists(memberDoc(hid, invite.createdBy)) && !existsAfter(inviteDoc(code))
        && get(householdDoc(hid)).data.deleted == false;
    }

    // The one-household check of a member create (PLAN 3.1): the caller's users doc exists and holds
    // no household before the batch and this one after it, so the same batch must set it. A missing
    // doc fails; a stale value must be self-healed first.
    function oneHousehold(hid) {
      let user = userDoc(request.auth.uid);
      return exists(user) && get(user).data.householdId == null
        && getAfter(user).data.householdId == hid;
    }

    // The household update (PLAN 3.1), by the owner of the live household (O(uid): ownerUid before
    // the write, never M(uid)), two paths. The soft delete (Delete household), no call: deleted
    // false -> true and the name cleared (#205), nothing else, so no household name, a street
    // address say, outlives the household; from then on the household is a tombstone for good.
    // Transfer ownership: only ownerUid changes, to a member before and after the batch, after
    // which the old owner's role is member and the new owner's owner, so the batch holds both role
    // updates (no partial transfer). The new ownerUid is a string (P4): a path takes a number as a
    // document id.
    function updatesHousehold(hid) {
      let before = resource.data;
      let after = request.resource.data;
      return before.deleted == false && before.ownerUid == request.auth.uid
        && ((after.deleted == true && after.name == ''
            && after.diff(before).affectedKeys().hasOnly(['deleted', 'name']))
          || (after.ownerUid is string && after.diff(before).affectedKeys().hasOnly(['ownerUid'])
            && exists(memberDoc(hid, after.ownerUid)) && existsAfter(memberDoc(hid, after.ownerUid))
            && getAfter(memberDoc(hid, before.ownerUid)).data.role == 'member'
            && getAfter(memberDoc(hid, after.ownerUid)).data.role == 'owner'));
    }

    // A member doc update (PLAN 3.1) while the household is live; an update implies the doc. Two
    // paths: the caller's own displayName, a name (P4); and the transfer's role update, by the owner
    // before the batch (O(uid)), to the role ownerUid gives this doc after it: owner for the new
    // owner, member for anyone else. ownerUid is the source of truth, role a cached copy.
    function updatesMember(hid, uid) {
      let household = get(householdDoc(hid)).data;
      let doc = request.resource.data;
      let changed = doc.diff(resource.data).affectedKeys();
      return household.deleted == false
        && ((uid == request.auth.uid && changed.hasOnly(['displayName'])
            && validName(doc.displayName))
          || (household.ownerUid == request.auth.uid && changed.hasOnly(['role'])
            && doc.role == (getAfter(householdDoc(hid)).data.ownerUid == uid ? 'owner' : 'member')));
    }

    // Create invite (PLAN 3.1): a member of the live household, as createdBy, the household's name
    // copied (P2), expiring within 7 days. The code is <householdId>_<22-character secret>, checked
    // on its own (no data goes into the pattern), so a deleted code can be created again only for
    // its own household (P3, #243).
    function createsInvite(code) {
      let invite = request.resource.data;
      let household = get(householdDoc(invite.householdId)).data;
      return code.matches('^[A-Za-z0-9]{20}_[A-Za-z0-9_-]{22}$')
        && code.split('_')[0] == invite.householdId
        && invite.keys().hasAll(['householdId', 'householdName', 'createdBy', 'createdAt', 'expiresAt'])
        && invite.keys().hasOnly(['householdId', 'householdName', 'createdBy', 'createdAt', 'expiresAt'])
        && invite.createdBy == request.auth.uid && invite.createdAt == request.time
        && invite.expiresAt is timestamp
        && invite.expiresAt <= request.time + duration.value(7, 'd')
        && household.deleted == false && invite.householdName == household.name
        && exists(memberDoc(invite.householdId, request.auth.uid));
    }

    // Read one invite (PLAN 3.1): any verified user (they need the code, HH-03) while the household
    // is live; the join screen shows its householdName (P2). A code that does not exist has no
    // household to check, so its get is denied as well. Under a tombstone only the owner's cleanup.
    function readsInvite() {
      let household = get(householdDoc(resource.data.householdId)).data;
      return household.deleted == false || cleansUp(household);
    }

    // Query invites (PLAN 3.1, as the owner decided on #280, M1-O12): a member of the live household
    // lists the invites they created, the owner all of the household's. Rules are not filters: the
    // query must fix householdId, and createdBy for a plain member. Under a tombstone only the
    // owner's cleanup, on householdId alone.
    function listsInvites() {
      let invite = resource.data;
      let household = get(householdDoc(invite.householdId)).data;
      return (household.deleted == false
          && (invite.createdBy == request.auth.uid || household.ownerUid == request.auth.uid)
          && exists(memberDoc(invite.householdId, request.auth.uid)))
        || cleansUp(household);
    }

    // Delete invite (PLAN 3.1) while the household is live: the revoke by its creator or the owner
    // (HH-02), any member's cleanup once it has expired, or the joiner's in the join batch: no
    // member before the batch, and the member doc after it names this code, so a member cannot burn
    // another's invite. Under a tombstone: the owner's cleanup. Paths in ADR 0002's order: creator,
    // owner, the tombstone cleanup, the expired cleanup (expiresAt first), the joiner.
    function deletesInvite(code) {
      let invite = resource.data;
      let household = get(householdDoc(invite.householdId)).data;
      return (invite.createdBy == request.auth.uid && household.deleted == false)
        || (household.ownerUid == request.auth.uid && household.deleted == false)
        || cleansUp(household)
        || (invite.expiresAt < request.time && household.deleted == false
          && exists(memberDoc(invite.householdId, request.auth.uid)))
        || (household.deleted == false
          && !exists(memberDoc(invite.householdId, request.auth.uid))
          && getAfter(memberDoc(invite.householdId, request.auth.uid)).data.viaInvite == code);
    }

    match /users/{uid} {
      allow get: if isCaller(uid);
      allow create: if isCaller(uid) && validUser(request.resource.data)
        && request.resource.data.householdId == null;
      allow update: if isCaller(uid) && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'name'])
        && householdIdChange(resource.data.householdId, request.resource.data.householdId);
      // Only with householdId null, never with a value, live or stale (P5); a delete of no doc is
      // allowed, so a resumed account deletion can repeat it (P7).
      allow delete: if isCaller(uid) && (resource == null || resource.data.householdId == null);
    }

    match /households/{hid} {
      // A member's read of the live household, or the tombstone read (readsHousehold).
      allow get: if signedIn() && readsHousehold(hid);
      allow create: if signedIn() && createsHousehold(hid);
      allow update: if signedIn() && updatesHousehold(hid);
      // No delete, for anyone, live or a tombstone (#199): the id stays taken for good. The cleanup
      // matches below name their subcollections; a recursive match here would match this doc too.

      // get: the caller's own member path in any household, live, a tombstone or none; it may not
      // exist. create and update: only as createsMember and updatesMember allow (the owner's doc
      // before the household exists, the joiner's while it is live; while it is live, the own
      // displayName and the transfer's role). delete: Leave, P6, the cleanup and Remove member
      // (deletesMember).
      match /members/{uid} {
        // get, besides the own path, and list: a member of the live household, or the owner's
        // cleanup under a tombstone (readsMembers).
        allow get: if signedIn() && (request.auth.uid == uid || readsMembers(hid));
        allow list: if signedIn() && readsMembers(hid);
        allow create: if signedIn() && createsMember(hid, uid);
        allow update: if signedIn() && updatesMember(hid, uid);
        allow delete: if signedIn() && deletesMember(hid, uid);
      }

      // The removed markers (PLAN 3.1 Remove member): owner only, no member read rule over the
      // household. The owner gets, lists and deletes them (managesMarkers); Remove member writes
      // one (writesMarker).
      match /removed/{uid} {
        allow get, list, delete: if signedIn() && managesMarkers(hid);
        allow create: if signedIn() && request.resource.data.keys().hasAll(['removedAt'])
          && writesMarker(hid, uid, request.resource.data.keys());
        allow update: if signedIn()
          && writesMarker(hid, uid, request.resource.data.diff(resource.data).affectedKeys());
      }
    }

    // Invites (PLAN 3.1): top level, the code is the document id (ADR 0002 (a)). No updates.
    match /invites/{code} {
      allow get: if signedIn() && readsInvite();
      allow list: if signedIn() && listsInvites();
      allow create: if signedIn() && createsInvite(code);
      allow delete: if signedIn() && deletesInvite(code);
    }

    // The app config document (PLAN 3, START-01): anyone reads it, even signed out, so an old app
    // can ask for an update before sign-in. No client writes it; the owner edits it in the console.
    match /config/app {
      allow get: if true;
    }
  }
}
