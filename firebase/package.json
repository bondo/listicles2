{
  "name": "tally-firebase",
  "private": true,
  "description": "Firestore rules and emulator tests",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "test": "firebase emulators:exec --only firestore --project demo-tally \"jest --runInBand\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.36.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "minimatch@>=7 <11": "11.0.8",
    "uuid": "11.1.1"
  }
}
