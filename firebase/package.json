{
  "name": "listicles-firebase",
  "private": true,
  "description": "Firestore rules and emulator tests",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "test": "firebase emulators:exec --only firestore --project demo-listicles \"jest --runInBand\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.36.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
