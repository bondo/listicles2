    // M1-09, the rules spike (PLAN 3.1 items a-e, docs/adr/0002-rules-spike.md). Test only:
    // spike.test.ts inserts these blocks under the documents match of firestore.rules; never deployed.
    // Each rule makes every get()/exists() call of its PLAN 3.1 row, reads a document once (let) and
    // tests the conditions that make no call first (ADR 0002's layout), so item (e) counts real calls.
    // The task named at a block moves it into firestore.rules, with its field validation (P4) and full
    // allow and deny tests, and deletes it here. M1-10 moved userDoc and oneHousehold (the owner's
    // member create needs them); (b) uses them from firestore.rules. M1-53 moved (c), the transfer:
    // spike.test.ts's (c) tests now run on firestore.rules.
    function inviteDoc(code) { return /databases/$(database)/documents/invites/$(code); }
    function live(hid) { return get(householdDoc(hid)).data.deleted == false; }

    // (a), M1-12: Query invites as the owner decided on #280 (M1-O12): a member of the live household
    // lists the invites they created, the owner all. Rules are not filters: the query's filters must
    // fix householdId, and createdBy for a plain member.
    function listsInvites(data) {
      let household = get(householdDoc(data.householdId)).data;
      return household.deleted == false
        && (data.createdBy == request.auth.uid || household.ownerUid == request.auth.uid)
        && exists(memberDoc(data.householdId, request.auth.uid));
    }

    // (b), M1-54: Join. The caller's own member doc (P1), created with the invite's delete and the
    // users-doc set in one batch: the invite points at hid, has not expired, its creator is still a
    // member, it is gone after the batch; LIVE; the one-household check. A create implies !M(uid).
    function joins(hid, uid) {
      let doc = request.resource.data;
      return uid == request.auth.uid && doc.role == 'member' && doc.joinedAt == request.time
        && joinsVia(hid, doc.viaInvite, get(inviteDoc(doc.viaInvite)).data);
    }

    function joinsVia(hid, code, invite) {
      return invite.householdId == hid && invite.expiresAt > request.time
        && exists(memberDoc(hid, invite.createdBy)) && !existsAfter(inviteDoc(code))
        && live(hid) && oneHousehold(hid);
    }

    // (d), M2: LIST-01's queries: the caller's own lists, or those shared with a live household the
    // caller is a member of.
    function readsList(data) {
      return data.createdBy == request.auth.uid
        || (data.sharedWith != null && exists(memberDoc(data.sharedWith, request.auth.uid))
          && live(data.sharedWith));
    }

    match /invites/{code} {
      allow list: if signedIn() && listsInvites(resource.data);
      // (b): the joiner's delete in the join batch: no member before it, and the member doc after it
      // names this code, so a member cannot burn another's invite.
      allow delete: if signedIn()
        && !exists(memberDoc(resource.data.householdId, request.auth.uid))
        && getAfter(memberDoc(resource.data.householdId, request.auth.uid)).data.viaInvite == code
        && live(resource.data.householdId);
    }

    match /households/{hid}/members/{uid} {
      allow create: if signedIn() && joins(hid, uid);
    }

    match /lists/{lid} {
      allow list: if signedIn() && readsList(resource.data);
    }
